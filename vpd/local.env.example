# Copy to vpd/local.env and edit for your cluster. Sourced by vpd/env.sh.

# Scratch directory for envs, caches, target model, configs, checkpoints, logs (needs ~100 GB+).
VPD_ROOT=/path/to/scratch/vpd

# Default sbatch options for this cluster (partition, account, QOS, excluded nodes, ...).
# GPU type and count are passed separately to vpd/slurm/submit.sh.
VPD_SBATCH_ARGS="-p my-partition -A my-account"

# GPU type for --gres (e.g. h100, a100, a40). Leave empty to request untyped gpus (--gres=gpu:N).
VPD_GPU_TYPE=

# CPUs and host RAM per GPU for training jobs.
VPD_CPUS_PER_GPU=6
VPD_MEM_PER_GPU_GB=40

# Max wall time of one job segment (training jobs requeue themselves until done).
VPD_TIME=2-00:00:00

# Optional: force NCCL peer-to-peer across PCIe host bridges/sockets. On the A40 nodes where this
# was developed (PCIe, no NVLink), NCCL defaulted to SHM at 1.7 GB/s; SYS gave 14.9 GB/s and cut
# step time 4.15 -> 1.62 s. Run vpd/slurm/nccl_bench.sbatch to decide. Leave empty on NVLink nodes.
VPD_NCCL_P2P_LEVEL=

# Optional: W&B. Without a key, set wandb_project: null in configs (make_config.py does by default).
# WANDB_API_KEY=...
# WANDB_ENTITY=...

# W&B project for training runs; empty -> wandb_project: null (local metrics.jsonl only).
VPD_WANDB_PROJECT=
